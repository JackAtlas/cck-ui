{
  "name": "@cck-ui/core",
  "version": "0.3.3",
  "description": "Vue component library focused on usability, accessibility and developer experience",
  "homepage": "https://cck-ui.jackatlas.xyz",
  "license": "ISC",
  "author": "JackAtlas <jackatlas8864@gmail.com>",
  "keywords": [
    "components",
    "frontend",
    "library",
    "vue",
    "ui"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./cjs/index.cjs",
  "module": "./esm/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./esm/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./cjs/index.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./styles.layer.css": "./styles.layer.css",
    "./styles/*": "./styles/*"
  },
  "repository": {
    "url": "https://github.com/JackAtlas/cck-ui",
    "type": "git",
    "directory": "packages/@cck-ui/core"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "@vueuse/core": "^14.3.0",
    "clsx": "^2.1.1",
    "type-fest": "^5.7.0"
  },
  "devDependencies": {
    "@cck-ui/hooks": "workspace:*",
    "@vue/shared": "^3.5.39",
    "csstype": "^3.2.3",
    "es-toolkit": "^1.49.0",
    "vue": "^3.5.39",
    "vue-component-type-helpers": "^3.3.5"
  },
  "peerDependencies": {
    "vue": "^3.5.39"
  }
}
