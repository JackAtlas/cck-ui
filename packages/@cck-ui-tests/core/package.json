{
  "name": "@cck-ui-tests/core",
  "version": "0.4.10",
  "description": "Core tests package for CCK UI",
  "homepage": "https://cck-ui.jackatlas.xyz",
  "license": "ISC",
  "author": "JackAtlas <jackatlas8864@gmail.com>",
  "keywords": [
    "vitest",
    "cck-ui",
    "tests"
  ],
  "sideEffects": false,
  "main": "./cjs/index.cjs",
  "module": "./esm/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
