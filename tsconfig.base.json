{
  "compilerOptions": {
    "outDir": "dist",
    "target": "es2024",
    "module": "esnext",
    "sourceMap": false,
    "moduleResolution": "bundler",
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "removeComments": false,
    "rootDir": ".",
    "types": [],
    "paths": {
      "@cck-ui/components": ["./packages/components"],
      "@cck-ui/components/*": ["./packages/components/*"],
      "cck-ui/constants": ["./packages/constants"],
      "cck-ui/hooks": ["./packages/hooks"],
      "cck-ui/utils": ["./packages/utils"],
      "cck-ui/utils/*": ["./packages/utils/*"],
      "cck-ui": ["./packages/cck-ui"]
    }
  }
}
