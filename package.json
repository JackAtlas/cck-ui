{
  "name": "cck-ui",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "type": "module",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm run -C internal/build start",
    "build:theme": "pnpm run -C packages/theme-slate build",
    "changeset": "changeset",
    "clean": "pnpm run clean:dist && pnpm run -r -parallel clean",
    "clean:dist": "rimraf dist",
    "commit": "cz",
    "docs:build": "pnpm run -C docs build",
    "docs:dev": "pnpm run -C docs dev",
    "docs:serve": "pnpm run -C docs serve",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx,.md,.json --max-warnings 0 --cache",
    "lint:fix": "pnpm run lint --fix",
    "play:dev": "pnpm run -C play dev",
    "postinstall": "pnpm stub",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "release": "pnpm build && changeset publish",
    "stub": "pnpm run -r --parallel stub",
    "test": "echo \"Error: no test specified\" && exit 1",
    "version": "changeset version"
  },
  "dependencies": {
    "@cck-ui/components": "workspace:^",
    "@cck-ui/eslint-config": "workspace:^",
    "@cck-ui/hooks": "workspace:^",
    "@cck-ui/theme-slate": "workspace:^",
    "@cck-ui/utils": "workspace:^",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@cck-ui/build": "workspace:^",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^24.12.4",
    "@vue/shared": "catalog:",
    "commitizen": "^4.3.1",
    "cz-git": "^1.13.1",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsx": "catalog:",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx,md,json}": "eslint --fix"
  }
}
