{
  "include": ["./src", "../../../@types"],
  "exclude": ["./lib", "./esm", "./cjs"],
  "compilerOptions": {
    "declaration": true,
    "types": ["node"],
    "target": "es2025",
    "lib": ["DOM", "ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@cck-ui/*": ["../*/src"]
    }
  }
}
