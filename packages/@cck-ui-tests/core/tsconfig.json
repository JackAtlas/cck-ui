{
  "include": ["./src", "../../../@types"],
  "exclude": ["./lib", "./esm", "./cjs"],
  "compilerOptions": {
    "declaration": true,
    "types": ["node", "vitest/globals"],
    "target": "es2025",
    "lib": ["DOM", "ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "vue",
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@cck-ui/*": ["../../@cck-ui/*/src"],
      "@cck-ui-tests/*": ["../*/src"]
    }
  }
}
