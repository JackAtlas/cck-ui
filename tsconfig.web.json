{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    "composite": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["DOM", "ESNext"],
    "types": [],
    "skipLibCheck": true
  },

  "include": ["packages", "typings/env.d.ts", "typings/style.d.ts"],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/__tests__/**",
    "**/buildfile.ts",
    "**/test-helper",
    "packages/test-utils",
    "*/*.md"
  ]
}
