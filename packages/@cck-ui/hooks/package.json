{
  "name": "@cck-ui/hooks",
  "version": "0.4.0",
  "description": "A collection of hooks for state and UI management",
  "homepage": "https://cck-ui.jackatlas.xyz",
  "license": "ISC",
  "author": "JackAtlas <jackatlas8864@gmail.com>",
  "keywords": [
    "frontend",
    "hooks",
    "library",
    "vue",
    "state"
  ],
  "sideEffects": false,
  "main": "./cjs/index.cjs",
  "module": "./esm/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./esm/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./cjs/index.cjs"
      }
    }
  },
  "repository": {
    "url": "https://github.com/JackAtlas/cck-ui",
    "type": "git",
    "directory": "packages/@cck-ui/hooks"
  },
  "peerDependencies": {
    "vue": "^3.5.39"
  }
}
