{
  "name": "cck-ui",
  "version": "0.2.0",
  "private": true,
  "description": "",
  "type": "module",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "build": "tsx scripts/build",
    "changeset": "changeset",
    "clean": "rimraf --glob packages/*/*/{esm,cjs,lib,dist} packages/*/*/*.tsbuildinfo packages/*/*/styles.css packages/*/*/styles.layer.css packages/@cck-ui/core/styles",
    "codegen": "pnpm generate-css-variables",
    "commit": "cz",
    "generate-css-variables": "tsx scripts/codegen/generate-default-css-variables && oxfmt packages/@cck-ui/core/src/core/config-provider/default-css-variables.css",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "play:dev": "pnpm run -C play dev",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "publish:package": "tsx scripts/publish",
    "publish:package:alpha": "tsx scripts/publish --stage alpha --tag next",
    "publish:package:beta": "tsx scripts/publish --stage beta --tag next",
    "release": "pnpm clean && tsx scripts/release",
    "release:ci": "tsx script/release --ci",
    "release:patch": "pnpm release patch --no-publish",
    "release:minor": "pnpm release minor --no-publish",
    "release:major": "pnpm release major --no-publish",
    "stub": "pnpm run -r --parallel stub",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "type-fest": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.0.1",
    "@types/yargs": "^17.0.35",
    "@vue/shared": "^3.5.39",
    "chalk": "^5.6.2",
    "commitizen": "^4.3.1",
    "consola": "^3.4.2",
    "cz-git": "^1.13.1",
    "fastest-levenshtein": "^1.0.16",
    "fs-extra": "^11.3.5",
    "hash-css-selector": "^1.1.0",
    "husky": "^9.1.7",
    "new-github-release-url": "^2.0.0",
    "open": "^11.0.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.15",
    "postcss-modules": "^6.0.1",
    "postcss-preset-cck": "^1.0.2",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "rolldown": "^1.1.3",
    "rollup-plugin-banner2": "^1.3.1",
    "simple-git": "^3.36.0",
    "tinyglobby": "^0.2.17",
    "tsx": "catalog:",
    "typescript": "^6.0.3",
    "unplugin-vue": "^7.2.0",
    "version-next": "^1.0.2",
    "yargs": "^17.7.3",
    "zx": "^8.8.5"
  }
}
