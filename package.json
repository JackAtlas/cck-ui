{
  "name": "cck-ui",
  "version": "0.15.0",
  "private": true,
  "description": "",
  "type": "module",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "build": "tsx scripts/build",
    "changeset": "changeset",
    "clean": "rimraf --glob packages/*/*/{esm,cjs,lib,dist} packages/*/*/*.tsbuildinfo packages/*/*/styles.css packages/*/*/styles.layer.css packages/@cck-ui/core/styles",
    "codegen": "pnpm generate-css-variables",
    "commit": "cz",
    "format:test": "oxfmt -c .oxfmtrc.json --check \"**/*.{ts,vue,css}\"",
    "format:write": "oxfmt -c .oxfmtrc.json --write \"**/*.{ts,vue.css}\"",
    "generate-css-variables": "tsx scripts/codegen/generate-default-css-variables && oxfmt packages/@cck-ui/core/src/core/config-provider/default-css-variables.css",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "play:dev": "pnpm run -C play dev",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "publish:package": "tsx scripts/publish",
    "publish:package:alpha": "tsx scripts/publish --stage alpha --tag next",
    "publish:package:beta": "tsx scripts/publish --stage beta --tag next",
    "release": "pnpm run test && pnpm run clean && tsx scripts/release",
    "release:ci": "tsx scripts/release --ci",
    "release:patch": "pnpm release patch --no-publish",
    "release:minor": "pnpm release minor --no-publish",
    "release:major": "pnpm release major --no-publish",
    "storybook": "storybook dev -p 6006",
    "stub": "pnpm run -r --parallel stub",
    "test": "pnpm run format:test && vitest run",
    "vitest": "vitest"
  },
  "dependencies": {
    "type-fest": "^5.8.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@storybook/vue3-vite": "^10.5.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/shared": "^3.5.39",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "catalog:",
    "chalk": "^5.6.2",
    "commitizen": "^4.3.2",
    "consola": "^3.4.2",
    "cz-git": "^1.13.1",
    "fastest-levenshtein": "^1.0.16",
    "fs-extra": "^11.3.6",
    "hash-css-selector": "^1.1.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "new-github-release-url": "^2.0.0",
    "open": "^11.0.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "postcss": "^8.5.19",
    "postcss-modules": "^9.0.1",
    "postcss-preset-cck": "^1.0.2",
    "postcss-simple-vars": "^7.0.1",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^6.1.3",
    "rolldown": "^1.1.5",
    "rollup-plugin-banner2": "^1.3.1",
    "simple-git": "^3.36.0",
    "storybook": "^10.5.0",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "unplugin-vue": "^7.2.0",
    "version-next": "^1.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "yargs": "^18.0.0",
    "zx": "^8.8.5"
  }
}
