      "require": {
        "types": "./lib/index.d.ts",
        "default": "./cjs/index.cjs"
      }
    }
  },
  "repository": {
    "url": "https://github.com/JackAtlas/cck-ui",
    "type": "git",
    "directory": "packages/@cck-ui-tests/core"
  },
  "peerDependencies": {
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@cck-ui/core": "workspace:*",
    "@cck-ui/hooks": "workspace:*",
    "@vue/test-utils": "^2.4.11",
    "vi-axe": "^1.0.0",
    "vue": "catalog:"
  }
}
